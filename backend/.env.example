allowed_origin=http://localhost:3000

# Optional: raises data.gov.sg's rate limit above the unauthenticated default.
# Get one at https://guide.data.gov.sg/developer-guide/api-overview/how-to-request-an-api-key
DATA_GOV_SG_API_KEY=

# Required for MRT line health (LTA DataMall Train Service Alerts).
# Get one at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_DATAMALL_API_KEY=
# Not currently used by any code - stored alongside the API key in case the
# LTA SDK is needed later.
LTA_SDK_ACCOUNT_KEY=
